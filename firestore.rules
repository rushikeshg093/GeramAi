rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if request is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user has active admin role in /admins/{uid}
    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == "admin" &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    // Admin collection: authenticated users can read ONLY their own document at /admins/{userId}
    match /admins/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update, delete: if false;
    }

    // Panchayat public profile: readable by anyone, writable only by admin
    match /panchayat/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Wards directory: readable by anyone, writable only by admin
    match /wards/{wardId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Water Supply Schedules: readable by anyone, writable only by admin
    match /water_supply/{supplyId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Notices: readable by anyone, writable only by admin
    match /notices/{noticeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Officials and Staff directory: readable by anyone, writable only by admin
    match /officials/{officialId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Development Projects: readable by anyone, writable only by admin
    match /projects/{projectId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Online Services catalog: readable by anyone, writable only by admin
    match /online_services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // System broadcast notifications: readable by anyone, writable only by admin
    match /notifications/{notificationId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Grievances / Complaints:
    // - Public or logged-in users can create complaints and read individual or all complaints
    // - Only admin or owner can update
    match /complaints/{complaintId} {
      allow read, create: if true;
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.id == request.auth.uid);
    }

    // Tanker bookings:
    // - Any citizen can create a tanker booking
    // - Admins can read and manage all tanker bookings
    match /tanker_bookings/{bookingId} {
      allow read, create: if true;
      allow update, delete: if isAdmin();
    }

    // Service applications:
    // - Citizens can create service applications
    // - Admins can read and approve/reject applications
    match /service_applications/{appId} {
      allow read, create: if true;
      allow update, delete: if isAdmin();
    }

    // Citizen Profiles:
    // - Admin can read/write all citizen records
    // - Individual citizen can read/write their own document
    // - gramPanchayatId is IMMUTABLE by citizen on update
    match /citizens/{citizenId} {
      allow read: if isAdmin() || (isAuthenticated() && request.auth.uid == citizenId);
      allow create: if isAdmin() || (isAuthenticated() && request.auth.uid == citizenId);
      allow update: if isAdmin() || (isAuthenticated() && request.auth.uid == citizenId && request.resource.data.gramPanchayatId == resource.data.gramPanchayatId);
      allow delete: if isAdmin();
    }

    // Authorized Citizen Registry:
    // - Master census/voter records per Gram Panchayat
    // - Readable for verification lookup
    // - Writable by Admin or verified onboarding
    match /authorized_citizens/{mobileNumber} {
      allow read: if true;
      allow write: if isAdmin() || isAuthenticated();
    }

    // AI Call System collections: STRICTLY accessible ONLY by verified Admins
    // Citizen users MUST NEVER be able to read or write these collections
    match /ai_announcements/{announcementId} {
      allow read, write: if isAdmin();
    }
    match /ai_call_campaigns/{campaignId} {
      allow read, write: if isAdmin();
    }
    match /ai_call_logs/{logId} {
      allow read, write: if isAdmin();
    }
    match /ai_scheduled_calls/{scheduledId} {
      allow read, write: if isAdmin();
    }
    match /ai_call_settings/{settingId} {
      allow read, write: if isAdmin();
    }
  }
}
